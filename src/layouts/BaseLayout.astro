---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/portfolio';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title = `${profile.name} — ${profile.subtitle}`,
  description = profile.tagline,
  fullWidth = false,
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href;
---

<!doctype html>
<html lang="en" data-aesthetic="cyberzone">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const storedScheme = localStorage.getItem('color-scheme');
        document.querySelector('meta[name="color-scheme"]').content = storedScheme ?? 'dark';
      } catch (e) {
        document.querySelector('meta[name="color-scheme"]').content = 'dark';
      }
      document.documentElement.dataset.aesthetic = 'cyberzone';
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- OpenGraph & Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Typography: Fraunces (Frieren Display), Space Grotesk (Cyberzone Display), Plus Jakarta Sans, Inter (Body), JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600..800;1,9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@600;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-[var(--bg-elevated)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-[var(--text-primary)] focus:ring-2 focus:ring-[var(--accent)]"
    >
      Skip to content
    </a>

    <Navbar />

    <main
      id="main-content"
      class:list={[
        'flex-1',
        !fullWidth && 'mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6 lg:px-8',
      ]}
    >
      <slot />
    </main>

    <Footer />

    <script>
      import Lenis from 'lenis';

      const prefersMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

      // 1. Lenis smooth inertia scroll + anchor routing
      if (prefersMotion) {
        const lenis = new Lenis({
          lerp: 0.085,
          smoothWheel: true,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        document.addEventListener('click', (event) => {
          const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href*="#"]');
          if (!link) return;
          const url = new URL(link.href, window.location.href);
          if (url.pathname !== window.location.pathname || !url.hash) return;
          const target = document.querySelector<HTMLElement>(url.hash);
          if (!target) return;
          event.preventDefault();
          lenis.scrollTo(target, { offset: -72, duration: 1.15 });
          history.pushState(null, '', url.hash);
        });
      }

      // 2. Staggered spring-unblur scroll reveal observer
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (prefersMotion && revealEls.length > 0) {
        document.documentElement.classList.add('has-reveal');

        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              target.dataset.revealed = 'true';
              revealObserver.unobserve(target);
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
        );

        requestAnimationFrame(() => {
          revealEls.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight * 0.94 && rect.bottom > 0) {
              el.dataset.revealed = 'true';
            } else {
              revealObserver.observe(el);
            }
          });
        });
      }

      // 3. Scroll progress rail fallback when native CSS scroll() timeline is unavailable
      const rail = document.getElementById('scroll-rail');
      if (rail && !CSS.supports('animation-timeline', 'scroll()') && prefersMotion) {
        const updateRail = () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          rail.style.transform = `scaleX(${ratio})`;
        };
        window.addEventListener('scroll', updateRail, { passive: true });
        window.addEventListener('resize', updateRail, { passive: true });
        updateRail();
      }

      // 4. Progressive fallback for Invoker Commands (`command` / `commandfor`) on <dialog>
      if (!('commandForElement' in HTMLButtonElement.prototype)) {
        document.addEventListener('click', (event) => {
          const trigger = (event.target as Element | null)?.closest<HTMLButtonElement>(
            'button[command][commandfor]',
          );
          if (!trigger) return;
          const targetId = trigger.getAttribute('commandfor');
          const action = trigger.getAttribute('command');
          if (!targetId) return;
          const dialog = document.getElementById(targetId);
          if (!(dialog instanceof HTMLDialogElement)) return;
          if (action === 'show-modal' && !dialog.open) {
            dialog.showModal();
          } else if ((action === 'close' || action === 'request-close') && dialog.open) {
            dialog.close();
          }
        });
      }

      // 5. Light-dismiss fallback for <dialog closedby="any"> when closedBy is unsupported
      if (!('closedBy' in HTMLDialogElement.prototype)) {
        const outside = (e: PointerEvent, dialog: HTMLDialogElement) => {
          const r = dialog.getBoundingClientRect();
          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
        };
        for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[closedby="any"]')) {
          let pressedOutside = false;
          dialog.addEventListener('pointerdown', (e) => {
            pressedOutside = outside(e, dialog);
          });
          dialog.addEventListener('pointerup', (e) => {
            if (pressedOutside && outside(e, dialog)) dialog.close();
          });
        }
      }

      // 6. Interactive photo reel switcher inside event <dialog> modals
      document.addEventListener('click', (event) => {
        const tabBtn = (event.target as Element | null)?.closest<HTMLButtonElement>(
          '[data-reel-btn]',
        );
        if (!tabBtn) return;
        const container = tabBtn.closest<HTMLElement>('[data-photo-reel]');
        if (!container) return;

        const nextSrc = tabBtn.dataset.photoSrc;
        const nextCaption = tabBtn.dataset.photoCaption;
        const imgEl = container.querySelector<HTMLImageElement>('[data-reel-img]');
        const captionEl = container.querySelector<HTMLElement>('[data-reel-caption]');

        if (imgEl && nextSrc) {
          imgEl.src = nextSrc;
          if (nextCaption) imgEl.alt = nextCaption;
        }
        if (captionEl && nextCaption) {
          captionEl.textContent = nextCaption;
        }

        container.querySelectorAll<HTMLButtonElement>('[data-reel-btn]').forEach((btn) => {
          const active = btn === tabBtn;
          btn.setAttribute('aria-pressed', String(active));
          btn.classList.toggle('border-[var(--accent)]', active);
          btn.classList.toggle('text-[var(--accent)]', active);
          btn.classList.toggle('border-transparent', !active);
          btn.classList.toggle('text-[var(--text-secondary)]', !active);
        });
      });
    </script>
  </body>
</html>
