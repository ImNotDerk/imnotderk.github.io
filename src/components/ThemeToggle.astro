<button
  type="button"
  data-theme-toggle
  class="inline-flex h-7 w-7 items-center justify-center text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)] cursor-pointer"
>
  <span class="theme-icon-sun">
    <span class="sr-only">Switch to light theme</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </span>
  <span class="theme-icon-moon">
    <span class="sr-only">Switch to dark theme</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
</button>

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function getRenderedScheme(): 'light' | 'dark' {
    const content = meta?.content;
    if (content === 'light' || content === 'dark') {
      return content;
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyScheme(value: string | null) {
    if (!meta) return;
    meta.content = value === 'light' || value === 'dark' ? value : 'dark';
  }

  toggleBtn?.addEventListener('click', () => {
    const next = getRenderedScheme() === 'dark' ? 'light' : 'dark';
    applyScheme(next);
    try {
      localStorage.setItem('color-scheme', next);
    } catch {
      // Ignore storage errors when site data is restricted
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'color-scheme') {
      applyScheme(event.newValue);
    }
  });
</script>
