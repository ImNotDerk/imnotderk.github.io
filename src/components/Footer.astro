---
import { profile } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-[var(--border-hairline)]">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-8 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center sm:px-6 lg:px-8"
  >
    <p class="font-mono">
      <span class="theme-only-frieren">
        Theme 01: Sousou no Frieren (Stills &copy; K. Yamada / Madhouse) &middot; &copy; {year} {profile.name}
      </span>
      <span class="theme-only-cyberzone">
        Theme 02: Cyberpunk: Edgerunners (Stills &copy; Trigger / CDPR) &middot; &copy; {year} {profile.name}
      </span>
    </p>
    <div class="flex flex-wrap items-center gap-4 font-mono">
      {
        profile.socials.map((social) => (
          <a
            href={social.href}
            target={social.kind === 'email' ? undefined : '_blank'}
            rel={social.kind === 'email' ? undefined : 'noopener noreferrer'}
            class="transition-colors hover:text-[var(--text-primary)]"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
