---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/portfolio';
import { withBase } from '../utils/paths';

const navLinks = [
  { id: 'about', label: 'About', href: withBase('/#about') },
  { id: 'work', label: 'Work', href: withBase('/#work') },
  { id: 'experience', label: 'Experience', href: withBase('/#experience') },
  { id: 'contact', label: 'Contact', href: withBase('/#contact') },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)]/70 backdrop-blur-md">
  <div id="scroll-rail" aria-hidden="true"></div>

  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href={withBase('/#top')}
      class="font-display text-lg font-bold tracking-tight text-[var(--text-primary)]"
    >
      {profile.name}<span class="text-[var(--accent)]">.</span>
    </a>

    <div class="flex items-center gap-4 sm:gap-5">
      <nav aria-label="Primary" class="hidden items-center gap-5 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-scene-link={link.id}
              class="nav-editorial text-xs font-medium"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3 border-[var(--border-hairline)] lg:border-l lg:pl-4 sm:gap-4">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
