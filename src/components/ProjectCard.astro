---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const {
  title,
  summary,
  role,
  period,
  metrics,
  stack,
  coverImage,
  coverAlt,
} = project.data;
const indexLabel = String(index + 1).padStart(2, '0');
---

<article
  data-reveal
  class="grid grid-cols-1 items-center gap-8 py-12 lg:grid-cols-12 lg:gap-14"
>
  <!-- Visual Column (alternates left/right on desktop) -->
  <div class:list={['lg:col-span-7', index % 2 === 1 && 'lg:order-2']}>
    <div
      class="parallax-wrap cyber-scan block aspect-video w-full overflow-clip rounded-3xl border border-[var(--border-hairline)] bg-[var(--bg-subtle)]"
    >
      <img
        src={withBase(coverImage)}
        alt={coverAlt}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Minimal Narrative Column -->
  <div class:list={['lg:col-span-5', index % 2 === 1 && 'lg:order-1']}>
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--text-muted)]">
      <span class="font-semibold text-[var(--accent)]">{indexLabel}</span> &middot; {period} &middot; {role}
    </p>

    <h3
      class="font-display mt-3 text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
    >
      {title}
    </h3>

    <p class="mt-3 text-base leading-relaxed text-[var(--text-secondary)]">
      {summary}
    </p>

    {
      metrics.length > 0 && (
        <p class="mt-4 flex flex-wrap items-center gap-3 font-mono text-xs font-medium text-[var(--accent)]">
          {metrics.slice(0, 2).map((metric, idx) => (
            <>
              {idx > 0 && <span aria-hidden="true" class="text-[var(--border-hover)]">|</span>}
              <span>{metric}</span>
            </>
          ))}
        </p>
      )
    }

    <p class="mt-3 font-mono text-xs text-[var(--text-muted)]">
      {stack.slice(0, 4).join(' / ')}
    </p>
  </div>
</article>
